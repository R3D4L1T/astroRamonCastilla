---
import Layout from '../../layouts/Layout.astro'
import { tourismPlaces } from '../../components/tourism/TourismPlaces'

const place = tourismPlaces.find(p => p.slug === 'plaza-principal')!
---

<Layout title={`${place.title} - Turismo Comunidad`}>

  <main>

    <!-- HERO IMAGE -->
    <section class="relative h-[50vh] md:h-[70vh] overflow-hidden">
      <img
        src={place.image}
        alt={place.title}
        class="w-full h-full object-cover animate-fade-in"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>

      <div class="absolute bottom-0 left-0 right-0 p-6 md:p-16">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-neutral-400 hover:text-white transition-colors duration-300 mb-6 group"
        >
          <span class="group-hover:-translate-x-1 transition-transform duration-300">&larr;</span>
          <span class="uppercase tracking-[0.3em] text-xs">Volver al inicio</span>
        </a>

        <h1 class="text-4xl sm:text-5xl md:text-8xl font-black uppercase leading-[0.9] mb-4">
          {place.title}
        </h1>

        <p class="text-lg md:text-2xl text-neutral-300 max-w-2xl font-light">
          {place.subtitle}
        </p>
      </div>
    </section>

    <!-- CONTENIDO -->
    <section class="py-20 md:py-32 px-6">
      <div class="max-w-4xl mx-auto">

        <div class="mb-20">
          <span class="text-xs uppercase tracking-[0.3em] text-neutral-500 mb-4 block">
            Acerca del lugar
          </span>
          <p class="text-lg md:text-2xl leading-relaxed text-neutral-200 font-light">
            {place.description}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
          <div class="border border-neutral-800 hover:border-neutral-600 rounded-2xl p-8 transition-colors duration-500">
            <span class="text-xs uppercase tracking-[0.3em] text-neutral-500 block mb-3">
              Ubicación
            </span>
            <p class="text-xl md:text-2xl font-medium">{place.location}</p>
          </div>
          <div class="border border-neutral-800 hover:border-neutral-600 rounded-2xl p-8 transition-colors duration-500">
            <span class="text-xs uppercase tracking-[0.3em] text-neutral-500 block mb-3">
              Mejor época para visitar
            </span>
            <p class="text-xl md:text-2xl font-medium">{place.date}</p>
          </div>
        </div>

        <div>
          <span class="text-xs uppercase tracking-[0.3em] text-neutral-500 mb-6 block">
            Características
          </span>
          <div class="flex flex-wrap gap-4">
            {
              place.features.map(feature => (
                <span
                  class="bg-white text-black px-6 py-3 text-sm uppercase tracking-[0.2em] relative font-medium"
                  style="clip-path: polygon(0 0, 92% 0, 100% 50%, 92% 100%, 0 100%);"
                >
                  {feature}
                </span>
              ))
            }
          </div>
        </div>

        <div class="mt-24 pt-12 border-t border-neutral-800">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-neutral-400 hover:text-white transition-colors duration-300 group text-lg"
          >
            <span class="group-hover:-translate-x-2 transition-transform duration-300">&larr;</span>
            <span>Explorar más lugares turísticos</span>
          </a>
        </div>

      </div>
    </section>

  </main>

</Layout>

