---
interface Props {
  title: string
  slug: string
  description: string
  location: string
  date: string
  image: string
  tags: string[]
}

const {
  title,
  slug,
  description,
  location,
  date,
  image,
  tags
} = Astro.props
---

<a
    href=`/tourism/${slug}`
>
<div
  class="group bg-muted cursor-pointer hover:bg-black hover:-translate-y-1 hover:shadow-2xl flex flex-col overflow-hidden rounded-3xl transition-all duration-500 md:h-[450px] md:flex-row text-black font-black"
>
  <!-- CONTENIDO -->
  <div
      class="flex flex-1 flex-col justify-between gap-6 p-6 md:p-8 lg:gap-8 py-15"
  >
    <!-- TEXTOS -->
    <div class="flex flex-col gap-5">
      <div class="space-y-4">
        <h3
          class="text-primary group-hover:text-white text-3xl font-bold uppercase tracking-tighter transition-colors duration-500 md:text-4xl text-black font-black"
        >
        {title}
        </h3>

        <p
          class="text-secondary group-hover:text-white line-clamp-3 text-sm leading-relaxed transition-colors duration-500 md:text-base text-black font-black"
        >
        {description}
        </p>
      </div>

      <!-- INFO -->
      <div class="space-y-3">
          <div
            class="text-secondary group-hover:text-white flex items-center gap-2 text-sm transition-colors duration-500"
        >
          <span class="font-semibold uppercase tracking-widest">
            Location:
          </span>

          <span>{location}</span>
        </div>

        <div
          class="text-secondary group-hover:text-white flex items-center gap-2 text-sm transition-colors duration-500"
        >
          <span class="font-semibold uppercase tracking-widest">
            Mejor fecha para visitar:
          </span>

          <span>{date}</span>
        </div>
      </div>
    </div>

    <!-- TAGS -->
    <div class="flex flex-wrap justify-end gap-4 pt-10">

      {
        tags.map((tag) => (
          <span
            class="bg-black text-white group-hover:bg-white group-hover:text-black  px-5 py-3 text-sm uppercase tracking-[0.2em]"
            style="clip-path: polygon(0 0, 92% 0, 100% 50%, 92% 100%, 0 100%);"
          >
            {tag}
          </span>
        ))
      }

    </div>
  </div>

  <!-- IMAGEN -->
  <div class="relative aspect-video overflow-hidden md:h-full md:w-[55%]">
    <img
      src={image}
      alt={title}
      class="h-full w-full object-cover grayscale transition-all duration-700 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
      />
  </div>
</div>
</a>

