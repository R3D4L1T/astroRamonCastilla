---
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  location: string;
  year: string;
  category: string;
  image: ImageMetadata | ImageMetadata[] | string;
  alt: string;
}

const { title, location, year, category, image, alt } = Astro.props;

const resolvedImage = Array.isArray(image) ? image[0] : image;

const isRemoteImage = typeof resolvedImage === 'string' && (resolvedImage.startsWith('http') || resolvedImage.startsWith('https'));
---

<div class="group cursor-pointer">
  <div class="relative overflow-hidden mb-4 bg-slate-200 dark:bg-slate-800 rounded flex items-center justify-center">
    {
      typeof resolvedImage === 'string' ? (
        <img
          src={resolvedImage}
          alt={alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width={800}
          height={600}
        />
      ) : (
        <img
          src={resolvedImage.src}
          alt={alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width={resolvedImage.width}
          height={resolvedImage.height}
        />
      )
    }
  </div>

  <div class="flex justify-between items-start">
    <div>
      <h3 class="text-slate-900 dark:text-slate-100 text-lg font-semibold tracking-tight">{title}</h3>
      <p class="text-slate-500 dark:text-slate-400 text-sm font-light">{category} • {location}</p>
    </div>
    <span class="text-slate-400 text-sm font-medium">{year}</span>
  </div>
</div>
