---
import Container from '../shared/Container.astro';
import { activityCategories } from '../../data/activities';

const filters = activityCategories.map((name) => ({
  name,
  active: name === "Todas las Actividades",
}));
---

<Container>
  <div id="posts-filters" class="flex flex-wrap gap-2 mb-10 border-b border-slate-200 dark:border-slate-800 pb-6">
    {filters.map((filter) => (
      <button
        data-filter={filter.name}
        class:list={[
          "filter-btn px-5 py-2 rounded text-sm font-medium transition-all",
          filter.active
            ? "bg-primary text-white"
            : "text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800"
        ]}
      >
        {filter.name}
      </button>
    ))}
  </div>
</Container>

<script>
  const filterButtons = document.querySelectorAll("#posts-filters .filter-btn");
  const postItems = document.querySelectorAll<HTMLElement>(".post-card-item");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterButtons.forEach((b) => {
        b.classList.remove("bg-primary", "text-white");
        b.classList.add("text-slate-600", "dark:text-slate-400", "hover:bg-slate-200", "dark:hover:bg-slate-800");
      });
      btn.classList.remove("text-slate-600", "dark:text-slate-400", "hover:bg-slate-200", "dark:hover:bg-slate-800");
      btn.classList.add("bg-primary", "text-white");

      const selected = btn.getAttribute("data-filter");

      postItems.forEach((item) => {
        const category = item.getAttribute("data-category");
        if (selected === "Todas las Actividades" || category === selected) {
          item.classList.remove("hidden-by-filter");
        } else {
          item.classList.add("hidden-by-filter");
        }
      });

      updateLoadMoreVisibility();
    });
  });

  function updateLoadMoreVisibility() {
    const visibleByFilter = document.querySelectorAll<HTMLElement>(".post-card-item:not(.hidden-by-filter)");
    const loadMoreBtn = document.getElementById("load-more-btn");
    if (loadMoreBtn) {
      const allShown = Array.from(visibleByFilter).every((item) => !item.classList.contains("hidden"));
      (loadMoreBtn as HTMLElement).style.display = allShown ? "none" : "";
    }

  }
</script>

<style is:global>
  .hidden-by-filter {
    display: none !important;
  }
</style>
